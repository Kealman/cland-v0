#!/usr/bin/perl
# PROTOTYPE stand-in (ticket #11): prints the tty size (stty size = rows cols)
# at start and on every SIGWINCH. Ctrl+C quits.
use strict;
use warnings;
$| = 1;
my $label = shift // 'winch';
my $count = 0;
sub size { my $s = `stty size`; chomp $s; return $s }
$SIG{WINCH} = sub { $count++; printf "%s SIGWINCH #%d size=%s\n", $label, $count, size() };
printf "%s start size=%s\n", $label, size();
sleep 1 while 1;
