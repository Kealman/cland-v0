#!/usr/bin/perl
# PROTOTYPE stand-in (ticket #11): renders like an Ink-based harness prompt
# (Claude Code). Prints a transcript long enough to fill the screen, then an
# input box at the bottom, and on every key erases and redraws the box with
# relative cursor moves only (ESC[1A, ESC[2K), the way Ink's log-update does.
# Ctrl+D quits.
use strict;
use warnings;
$| = 1;
my $lines = shift // 80;
chomp(my $saved = `stty -g`);
system('stty raw -echo');
my ($rows, $cols) = split ' ', `stty size`;
my $w = ($cols > 20 ? $cols : 40) - 2;
printf "transcript line %03d %s\r\n", $_, '-' x 30 for 1 .. $lines;
my $input = '';
my $drawn = 0;
sub box {
  my @out = ('+' . ('-' x ($w - 2)) . '+', sprintf('| > %-*s|', $w - 5, substr($input, -($w - 6))), '+' . ('-' x ($w - 2)) . '+');
  print "\e[2K\e[1A" x ($drawn - 1), "\e[2K\r" if $drawn;
  print join("\r\n", @out);
  $drawn = scalar @out;
}
box();
while (sysread(STDIN, my $c, 64)) {
  last if $c eq "\x04";
  if ($c eq "\x7f") { chop $input } elsif ($c !~ /[\x00-\x1f]/) { $input .= $c }
  box();
}
system("stty $saved");
print "\r\nprompt-sim done\r\n";
