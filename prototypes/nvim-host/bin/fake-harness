#!/usr/bin/env bash
# PROTOTYPE stand-in (ticket #15, workbench): "attaches" to one fake session.
# It prints the attach command a real adapter would run (spec 4.3), a canned
# harness screen, and, when the session waits for approval, the harness's own
# approval prompt: [y]/[a]/[n] answer it here, in the TUI, and the answer goes
# back to the workbench as an OSC 777 sequence (Neovim's TermRequest), the way
# an adapter would report the state change. Then it hands the terminal to your
# $SHELL without rc files. No harness is started.
#   fake-harness <session> <role> <harness> <model> <attach command>
#   env: CLAND_PROTO_APPROVAL (command waiting for approval), CLAND_PROTO_ITEM
name="${1:-session}" role="${2:-}" harness="${3:-}" model="${4:-}" attach="${5:-}"
approval="${CLAND_PROTO_APPROVAL:-}"
B=$'\033[1m' D=$'\033[2m' R=$'\033[0m'
P=$'\033[38;5;141m' G=$'\033[38;5;114m' Y=$'\033[38;5;221m' C=$'\033[38;5;80m' O=$'\033[38;5;215m'

printf '%s›%s %s\n\n' "$D" "$R" "${attach:-attach $name}"

case "$name" in
coord-1)
  cat <<EOF
${O}✻${R} ${B}Claude Code${R} ${D}(fake)${R} · session ${B}coord-1${R} · Coordinator · fable · max
${D}  cwd: the project root · hub: connected (spoke ok)${R}

${D}>${R} [hub] from you in "General" (topic general):
  Take T-13 next with impl-2, the Codex adapter. Keep rev-1 on the T-15 review.
  ${D}(injected: it entered this turn)${R}

${G}●${R} cland.task.claim(T-13, session: impl-2)
  ${D}⎿  claimed · branch t/T-13-codex-adapter from dev${R}
${G}●${R} cland.ask(topic: T-12, "Spoke identity on reconnect: which should win?", 3 options)
  ${D}⎿  ask open · the T-12 topic waits for the human${R}
${G}●${R} cland.artifact.create(diagram, "spoke reconnect sequence", topic: T-12)
  ${D}⎿  A-7 shared${R}

${O}✻ Planning T-13 with impl-2…${R} ${D}(9m 12s · esc to interrupt)${R}
EOF
  ;;
impl-1)
  cat <<EOF
${G}┃${R} ${B}opencode${R} ${D}(fake)${R} · session ${B}impl-1${R} · Implementer · free model
${G}┃${R} T-12 · branch t/T-12-hub-spoke-hello · worktree .cland/worktrees/T-12

${D}▣ build${R}  npm test -- hub/spoke     ${G}✓ 22 passed${R}
${D}▣ edit${R}   hub/spoke/hello.ts        ${D}+96 -4${R}

The hello works against the stub. Waiting for the human's answer on the
spoke identity before the real spoke (the ask in the T-12 topic).

${G}>${R} ${D}(idle: waiting for a delivery from the hub)${R}
EOF
  ;;
impl-2)
  cat <<EOF
${O}✻${R} ${B}Claude Code${R} ${D}(fake)${R} · session ${B}impl-2${R} · Implementer · opus · high
${D}  T-13 · branch t/T-13-codex-adapter · worktree .cland/worktrees/T-13${R}

${G}●${R} Bash(codex app-server --listen unix://.cland/sessions/probe.sock)
  ${D}⎿  listening${R}
${G}●${R} Write(hub/adapters/codex/spawn.ts)
  ${D}⎿  Wrote 118 lines${R}

${O}✻ Wiring codex resume --remote…${R} ${D}(6m 03s · esc to interrupt)${R}
EOF
  ;;
rev-1)
  cat <<EOF
  ${D}thread${R}   Review of t/T-15-role-clause-delivery against dev (round 1)
  ${D}model${R}    gpt-6.1-sol · effort high
  ${D}context${R}  hub event 12:04 · role clause: Reviewer · item T-15

  Reading the diff: 14 files, +612 −88.
  Running the hub tests to confirm the clause arrives on reconnect…
EOF
  ;;
qa-1)
  cat <<EOF
  ${D}thread${R}   QA lane setup
  ${D}model${R}    gpt-6-astra · effort high
  ${D}context${R}  role clause: QA (Implementer → QA, delivered by the hub)

  ${D}•${R} Lanes: headless Neovim (nvim_input + screenstring), tmux capture-pane, ttyd
  ${D}•${R} Waiting for a QA request.

${C}›${R} ${D}(idle)${R}
EOF
  ;;
*)
  printf '%s fake session %s (%s · %s · %s)\n' "$B" "$name" "$role" "$harness" "$model$R"
  ;;
esac

if [[ -n "$approval" ]]; then
  cat <<EOF

  ${Y}▲ approval needed${R}  run command:  ${B}${approval}${R}
                     [y] allow once   [a] always for this session   [n] deny

  ${D}You are inside the harness's own TUI. The answer is given here; the hub only shows the
  state "waiting for approval" in the items panel, the sessions panel and the inbox.${R}
EOF
  while true; do
    IFS= read -r -s -n 1 key || break
    case "$key" in
    y | Y | a | A)
      [[ "$key" == [aA] ]] && how="always for this session" || how="once"
      printf '\n  %s✓ allowed %s:%s running %s …\n' "$G" "$how" "$R" "$approval"
      printf '\033]777;cland;approval=allow\033\\'
      sleep 1
      printf '  %s✓ 7 passed (simulated)%s\n' "$G" "$R"
      break
      ;;
    n | N)
      printf '\n  %s✗ denied:%s tell %s what to do differently\n' "$Y" "$R" "$harness"
      printf '\033]777;cland;approval=deny\033\\'
      break
      ;;
    esac
  done
fi

sh_name="${SHELL##*/}"
printf '\n%s── PROTOTYPE stand-in: the screen above is canned; below is %s (no rc files), not %s ──%s\n\n' \
  "$D" "${sh_name:-sh}" "${harness:-a harness}" "$R"
export PS1="${name}\$ " PROMPT="${name}%# "
case "$sh_name" in
zsh) exec "$SHELL" -f ;;
bash) exec "$SHELL" --norc --noprofile ;;
*) exec "${SHELL:-/bin/sh}" ;;
esac
