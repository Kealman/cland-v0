---
// The frame of every non-docs page: head tags, brand styles, header and footer.
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { GOATCOUNTER, SITE } from '../site';

interface Props {
  title: string;
  description: string;
  /** True on the landing: nav links stay in-page anchors. */
  home?: boolean;
  /** The nav entry to mark as current. */
  current?: 'log';
  /** Open Graph type: a post is an article. */
  ogType?: 'website' | 'article';
  /** For an article: its publication date. */
  published?: Date;
  imageAlt?: string;
  /** Structured data (schema.org JSON-LD) for this page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  home = false,
  current,
  ogType = 'website',
  published,
  imageAlt = 'cland: all your subscriptions, one team',
  jsonLd,
} = Astro.props;
const site = Astro.site ?? new URL(SITE);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;
const rss = new URL('/log/rss.xml', site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0e14" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <!-- On a dark tile, in a size Google accepts for search results (a multiple of 48). -->
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="cland build log" href={rss} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="cland" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@cland_app" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline data-goatcounter={GOATCOUNTER} async src="https://gc.zgo.at/count.js"></script>
  </head>
  <body>
    <SiteHeader home={home} current={current} />
    <main id="top">
      <slot />
    </main>
    <SiteFooter home={home} />
  </body>
</html>
