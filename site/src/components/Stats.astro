---
// A row of headline numbers for a build-log post: the value, what it counts, and an optional comparison.
interface Stat {
  value: string;
  label: string;
  /** A comparison line, e.g. "v0.1.2: 56%". */
  was?: string;
}
interface Props {
  items: Stat[];
}

const { items } = Astro.props;
---

<dl class="stats not-prose">
  {
    items.map((s) => (
      <div class="stat">
        <dt>{s.label}</dt>
        <dd class="stat-value">{s.value}</dd>
        {s.was && <dd class="stat-was">{s.was}</dd>}
      </div>
    ))
  }
</dl>

<style>
  .stats {
    margin: 2rem 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .stat {
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  dt {
    font-size: 14px;
    line-height: 1.4;
    color: var(--body-muted);
  }
  dd {
    margin: 0;
  }
  /* The number reads first; the label and the comparison follow. */
  .stat-value {
    order: -1;
    font-family: var(--mono);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.15;
    color: var(--text);
    letter-spacing: -0.5px;
  }
  .stat-was {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .stat {
      padding: 14px;
    }
    .stat-value {
      font-size: 22px;
    }
  }
</style>
