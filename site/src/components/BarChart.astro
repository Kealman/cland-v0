---
// A horizontal bar chart in plain HTML and CSS, for build-log posts. Every value is printed as
// text beside its bar, so the chart reads without colour and at phone width.
//
// <BarChart title="..." caption="..." legend={[{ name: 'v0.1.2', color: 'muted' }]}
//   rows={[{ label: 'Merges per hour', bars: [{ value: 1.2, text: '1.2', color: 'muted' }] }]} />

type Colour = 'amber' | 'teal' | 'green' | 'blue' | 'violet' | 'pink' | 'red' | 'muted';
interface Bar {
  value: number;
  /** The printed value, e.g. "$1.17" or "56%". */
  text: string;
  color?: Colour;
}
interface Row {
  label: string;
  bars: Bar[];
}
interface Props {
  title: string;
  caption?: string;
  rows: Row[];
  legend?: { name: string; color: Colour }[];
  /** The value of a full-width bar; defaults to the largest value. Each row may scale on its own with `perRow`. */
  max?: number;
  /** Scale each row to its own largest bar: for before/after pairs in different units. */
  perRow?: boolean;
}

const { title, caption, rows, legend, max, perRow = false } = Astro.props;
const globalMax = max ?? Math.max(...rows.flatMap((r) => r.bars.map((b) => b.value)));
const width = (v: number, row: Row) => {
  const top = perRow ? Math.max(...row.bars.map((b) => b.value)) : globalMax;
  return top > 0 ? Math.max(0.6, (v / top) * 100) : 0;
};
const colour = (c: Colour = 'amber') => `var(--${c === 'muted' ? 'dash' : c})`;
---

<figure class="chart not-prose">
  <div class="chart-title">{title}</div>
  {
    legend && (
      <div class="chart-legend">
        {legend.map((l) => (
          <span>
            <i style={`background: ${colour(l.color)}`} />
            {l.name}
          </span>
        ))}
      </div>
    )
  }
  <div class="chart-rows">
    {
      rows.map((row) => (
        <div class="chart-row">
          <div class="chart-label">{row.label}</div>
          <div class="chart-bars">
            {row.bars.map((b) => (
              <div class="chart-bar">
                <div class="chart-track">
                  <div class="chart-fill" style={`width: ${width(b.value, row)}%; background: ${colour(b.color)}`} />
                </div>
                <span class="chart-value">{b.text}</span>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .chart {
    margin: 2rem 0;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel);
  }
  .chart-title {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.2px;
  }
  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .chart-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .chart-legend i {
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }
  .chart-rows {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 16px;
  }
  .chart-row {
    display: grid;
    grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
    gap: 4px 16px;
    align-items: center;
  }
  .chart-label {
    font-size: 14px;
    line-height: 1.35;
    color: var(--body-muted);
  }
  .chart-bars {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .chart-bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.75rem;
    gap: 10px;
    align-items: center;
  }
  .chart-track {
    height: 12px;
    border-radius: 3px;
    background: #161b24;
    overflow: hidden;
  }
  .chart-fill {
    height: 100%;
    border-radius: 3px;
  }
  .chart-value {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text);
    white-space: nowrap;
  }
  figcaption {
    margin-top: 16px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .chart {
      padding: 16px;
    }
    .chart-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
