---
// One build-log post as a card: date, release, title and description. Used on /log/ and the landing.
import { formatDate, isoDate } from '../site';
import { postHref, type Post } from '../log';

interface Props {
  post: Post;
  /** Heading level of the title inside the card, to fit the page outline. */
  level?: 'h2' | 'h3';
}

const { post, level = 'h3' } = Astro.props;
const Title = level;
---

<article class="post-card">
  <div class="post-meta">
    <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
    {post.data.release && <span class="release">{post.data.release}</span>}
  </div>
  <Title class="post-title"><a href={postHref(post)}>{post.data.title}</a></Title>
  <p class="post-desc">{post.data.description}</p>
</article>

<style>
  .post-card {
    position: relative;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 120ms ease;
  }
  .post-card:hover,
  .post-card:focus-within {
    border-color: var(--amber-border);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    min-height: 22px;
    gap: 8px 12px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  .release {
    padding: 1px 8px;
    border: 1px solid var(--amber-border);
    border-radius: 999px;
    background: var(--amber-ground);
    color: var(--amber);
    font-size: 12px;
  }
  .post-title {
    margin: 0;
    font-family: var(--mono);
    font-size: 19px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.2px;
  }
  /* The whole card is the link target; the title stays the accessible name. */
  .post-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
  }
  .post-card:hover .post-title a {
    color: var(--amber);
  }
  .post-desc {
    margin: 0;
    color: var(--body-muted);
    font-size: 16px;
  }
  @media (max-width: 600px) {
    .post-card {
      padding: 20px;
    }
    .post-title {
      font-size: 18px;
    }
  }
</style>
