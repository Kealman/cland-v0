---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../log';

const posts = await getPosts();
const title = 'Build log · cland';
const description =
  'cland is built by a cland crew. After every release we publish what it took, what it cost, what broke and what we changed.';
---

<SiteLayout title={title} description={description} current="log">
  <section class="wrap log-head">
    <div class="eyebrow">BUILD LOG</div>
    <h1>Built in public, by its own crew</h1>
    <p class="lead">
      cland is built by a cland crew: a Coordinator, Implementers, Reviewers and QA on the same hub you would run. After each release we write down what it took, what it cost, what broke and what we changed because of it.
    </p>
    <p class="feed"><a href="/log/rss.xml" class="amber-link">RSS feed →</a></p>
  </section>

  <section aria-label="Posts" class="wrap log-list">
    {posts.map((post) => <PostCard post={post} level="h2" />)}
  </section>
</SiteLayout>

<style>
  .wrap.log-head {
    max-width: 900px;
    padding-top: 88px;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  h1 {
    margin: 0;
    font-family: var(--mono);
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.1;
    letter-spacing: -1.2px;
  }
  .lead {
    margin: 0;
    max-width: 68ch;
    color: var(--body-muted);
    font-size: 19px;
  }
  .feed {
    margin: 0;
    font-family: var(--mono);
    font-size: 15px;
  }
  .amber-link {
    color: var(--amber);
  }
  .amber-link:hover {
    text-decoration: underline;
  }
  .wrap.log-list {
    max-width: 900px;
    padding-bottom: 96px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  @media (max-width: 600px) {
    .log-head {
      padding-top: 56px;
      padding-bottom: 32px;
    }
    .lead {
      font-size: 17px;
    }
    .log-list {
      padding-bottom: 64px;
    }
  }
</style>
