---
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPosts, postHref, type Post } from '../../log';
import { SITE, formatDate, isoDate } from '../../site';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // Posts are newest first: the previous entry is newer, the next one older.
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

// Reading time from the prose only: component tags and imports are not words.
const prose = (post.body ?? '')
  .split('\n')
  .filter((l) => !/^\s*(<|import |\/>|[a-zA-Z]+=|\]|\}|\{)/.test(l))
  .join(' ');
const minutes = Math.max(1, Math.round(prose.split(/\s+/).filter(Boolean).length / 230));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: isoDate(post.data.date),
  url: new URL(`/log/${post.id}/`, SITE).href,
  image: `${SITE}/og.png`,
  author: { '@type': 'Organization', name: 'cland', url: SITE },
  publisher: { '@type': 'Organization', name: 'cland', url: SITE },
};
---

<SiteLayout
  title={`${post.data.title} · cland build log`}
  description={post.data.description}
  current="log"
  ogType="article"
  published={post.data.date}
  jsonLd={jsonLd}
>
  <article class="wrap post">
    <header class="post-head">
      <a href="/log/" class="back">← Build log</a>
      <div class="post-meta">
        <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
        {post.data.release && <span class="release">{post.data.release}</span>}
        <span>{minutes} min read</span>
      </div>
      <h1>{post.data.title}</h1>
      <p class="post-lead">{post.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav aria-label="More posts" class="post-nav">
      {
        older ? (
          <a href={postHref(older)} class="post-nav-link">
            <span class="dir">← Older</span>
            <span class="t">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a href={postHref(newer)} class="post-nav-link newer">
            <span class="dir">Newer →</span>
            <span class="t">{newer.data.title}</span>
          </a>
        )
      }
    </nav>
    <p class="post-foot"><a href="/log/">All posts</a> · <a href="/log/rss.xml">RSS</a></p>
  </article>
</SiteLayout>

<style>
  .wrap.post {
    max-width: calc(68ch + 48px);
    padding-top: 64px;
    padding-bottom: 96px;
  }
  .post-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 32px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  .back {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--muted);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  .release {
    padding: 1px 8px;
    border: 1px solid var(--amber-border);
    border-radius: 999px;
    background: var(--amber-ground);
    color: var(--amber);
    font-size: 12px;
  }
  h1 {
    margin: 0;
    font-family: var(--mono);
    font-size: clamp(28px, 4.2vw, 40px);
    line-height: 1.15;
    letter-spacing: -0.8px;
  }
  .post-lead {
    margin: 0;
    font-size: 19px;
    color: var(--body-muted);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel);
  }
  .post-nav-link:hover {
    border-color: var(--amber-border);
  }
  .post-nav-link.newer {
    text-align: right;
  }
  .dir {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  .t {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
  }
  .post-foot {
    margin: 24px 0 0;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--muted);
  }
  .post-foot a {
    color: var(--amber);
  }
  @media (max-width: 600px) {
    .wrap.post {
      max-width: none;
      padding-top: 40px;
      padding-bottom: 64px;
    }
    .post-lead {
      font-size: 17px;
    }
    .post-nav {
      grid-template-columns: 1fr;
    }
    .post-nav-link.newer {
      text-align: left;
    }
  }
</style>
