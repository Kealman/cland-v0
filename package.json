{
  "name": "cland",
  "private": true,
  "description": "A terminal IDE for running and coordinating AI coding-agent harnesses.",
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "workspaces": [
    "hub"
  ],
  "bin": {
    "cland": "hub/bin/cland.ts"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspace hub && tsc -p nvim/tsconfig.json",
    "test": "node hub/test/run-suite.ts all",
    "test:nvim": "node hub/test/run-suite.ts nvim",
    "benchmark:thread": "CLAND_RENDER_BENCHMARK=1 node --test --test-name-pattern='200 message rewrites' nvim/test/thread.test.ts"
  }
}
