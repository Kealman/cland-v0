{
  "name": "cland",
  "private": true,
  "description": "A terminal IDE for running and coordinating AI coding-agent harnesses.",
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "workspaces": [
    "hub"
  ],
  "bin": {
    "cland": "hub/bin/cland.ts"
  },
  "scripts": {
    "check:opencode": "node hub/bin/check-opencode.ts",
    "typecheck": "npm run typecheck --workspace hub && node hub/bin/typecheck.ts -p nvim/tsconfig.json",
    "test": "node hub/test/run-suite.ts auto",
    "test:tiers": "node hub/test/lint-tiers.ts",
    "test:shards": "npm run test:tiers",
    "test:nvim": "node hub/test/run-suite.ts nvim",
    "benchmark:thread": "CLAND_RENDER_BENCHMARK=1 node --test --test-name-pattern='200 message rewrites' nvim/test/thread.test.ts",
    "test:durations": "node hub/test/durations.ts refresh"
  }
}
