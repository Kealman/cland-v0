#!/usr/bin/env node
// A stand-in for the GitHub CLI in tests: answers `gh api [--paginate] [--slurp] <path>` from the JSON map in
// $FAKE_GH_FIXTURE (path → the one page the endpoint returns) and appends each call to $FAKE_GH_LOG. `gh --version`
// and `gh auth status` answer as gh 2.102.0 signed in (FAKE_GH_LOGGED_OUT=1: not signed in, exit 1), for `cland doctor`.
import { appendFileSync, readFileSync } from 'node:fs';

const args = process.argv.slice(2);
if (process.env.FAKE_GH_LOG) appendFileSync(process.env.FAKE_GH_LOG, `${args.join(' ')}\n`);
if (args[0] === '--version') {
  process.stdout.write('gh version 2.102.0 (fake)\n');
  process.exit(0);
}
if (args[0] === 'auth' && args[1] === 'status') {
  if (process.env.FAKE_GH_LOGGED_OUT === '1') {
    process.stderr.write('You are not logged into any GitHub hosts. To log in, run: gh auth login\n');
    process.exit(1);
  }
  process.stdout.write('github.com\n  ✓ Logged in to github.com account fake-user (keyring)\n');
  process.exit(0);
}
if (args[0] !== 'api') {
  process.stderr.write(`fake gh: only \`gh api\` is answered, not: ${args.join(' ')}\n`);
  process.exit(1);
}
const path = args.slice(1).find((a) => !a.startsWith('-'));
const fixture = JSON.parse(readFileSync(process.env.FAKE_GH_FIXTURE ?? '', 'utf8'));
if (!path || !(path in fixture)) {
  process.stderr.write(`gh: Not Found (HTTP 404) ${path}\n`);
  process.exit(1);
}
const page = fixture[path];
process.stdout.write(`${JSON.stringify(args.includes('--slurp') ? [page] : page)}\n`);
