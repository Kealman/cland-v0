{
  "command": {
    "command": "/fixture/harness",
    "args": [
      "app-server",
      "--listen",
      "unix://<TMP>/cland-run/cx-fixturesessi.sock",
      "-c",
      "mcp_servers.cland.command=\"/fixture/node\"",
      "-c",
      "mcp_servers.cland.args=[\"/fixture/spoke\"]",
      "-c",
      "mcp_servers.cland.env_vars=[\"CLAND_LAUNCH_TOKEN\"]",
      "-c",
      "mcp_servers.cland.env.CLAND_HUB_FILE=\"<ROOT>/.cland/hub.json\"",
      "-c",
      "mcp_servers.cland.env.CLAND_SESSION_ID=\"fixture-session\"",
      "-c",
      "mcp_servers.cland.env.CLAND_SESSION_NAME=\"worker\"",
      "-c",
      "mcp_servers.cland.env.CLAND_DELIVERY=\"adapter\"",
      "-c",
      "mcp_servers.cland.env.CLAND_ROLE=\"implementer\"",
      "-c",
      "mcp_servers.cland.enabled=true",
      "-c",
      "mcp_servers.cland.required=true",
      "-c",
      "mcp_servers.cland.default_tools_approval_mode=\"approve\""
    ],
    "cwd": "<ROOT>",
    "env": {
      "XDG_CONFIG_HOME": "<ROOT>/config",
      "XDG_DATA_HOME": "<ROOT>/opencode",
      "XDG_STATE_HOME": "<ROOT>/state",
      "XDG_CACHE_HOME": "<ROOT>/cache",
      "GIT_AUTHOR_NAME": "Fixture Test",
      "GIT_AUTHOR_EMAIL": "fixture@example.test",
      "GIT_COMMITTER_NAME": "Fixture Test",
      "GIT_COMMITTER_EMAIL": "fixture@example.test",
      "CLAUDE_CONFIG_DIR": "<ROOT>/claude",
      "CODEX_HOME": "<ROOT>/codex",
      "FAKE_CLAUDE_HOME": "<ROOT>/fake-claude",
      "FAKE_CODEX_HOME": "<ROOT>/fake-codex",
      "FAKE_OPENCODE_HOME": "<ROOT>/fake-opencode",
      "PATH": "/fixture:/fixture/bin",
      "HOME": "<ROOT>/home",
      "GIT_CONFIG_GLOBAL": "<ROOT>/home/.gitconfig",
      "GIT_CONFIG_NOSYSTEM": "1",
      "OPENCODE_DB": "<ROOT>/account/opencode.db",
      "CLAND_SESSION_ID": "fixture-session",
      "CLAND_SESSION_NAME": "worker",
      "CLAND_ROLE": "implementer"
    },
    "logFile": "<ROOT>/.cland/log/codex-worker.log"
  },
  "disk": {}
}
