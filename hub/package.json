{
  "name": "@cland/hub",
  "version": "0.1.0",
  "private": true,
  "description": "The cland hub: the per-project service sessions talk through, the spoke each session runs, and the cland CLI.",
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "bin": {
    "cland": "bin/cland.ts"
  },
  "scripts": {
    "typecheck": "node bin/typecheck.ts -p tsconfig.json",
    "test": "node test/run-suite.ts hub",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "smol-toml": "1.9.0",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "typescript7": "npm:typescript@7.0.2",
    "zod": "4.5.4"
  }
}
